---
const { class: className = 'size-5', ...attributes } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  {...attributes}
>
  <circle
    cx="12"
    cy="12"
    r="9"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-dasharray="42 18"></circle>
</svg>
