---
import type { Locale, PortfolioContent } from '../data/portfolio';
import Footer from './Footer.astro';
import Header from './Header.astro';
import AboutSection from './sections/AboutSection.astro';
import ArticlesSection from './sections/ArticlesSection.astro';
import ContactSection from './sections/ContactSection.astro';
import ExperienceSection from './sections/ExperienceSection.astro';
import HeroSection from './sections/HeroSection.astro';
import ProjectsSection from './sections/ProjectsSection.astro';

interface Props {
  content: PortfolioContent;
  lang: Locale;
}

const { content, lang } = Astro.props;
---

<div
  class="relative overflow-x-clip bg-transparent text-[var(--text-primary)]"
  data-portfolio-root
  data-initial-lang={lang}
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[40rem]"
    style="background: var(--hero-glow);"
  >
  </div>
  <Header content={content} lang={lang} />

  <main id="top">
    <HeroSection content={content.hero} />
    <AboutSection content={content.about} />
    <ProjectsSection content={content.projects} />
    <ExperienceSection content={content.experience} />
    <ArticlesSection content={content.articles} />
    <ContactSection content={content.contact} />
  </main>

  <Footer content={content.footer} />
</div>
