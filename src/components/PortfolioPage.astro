---
import { portfolioContent, type Locale, type PortfolioContent } from '../data/portfolio';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  content: PortfolioContent;
  lang: Locale;
}

const { content, lang } = Astro.props as Props;
---

<div class="relative overflow-x-clip bg-transparent text-[var(--text-primary)]" data-portfolio-root data-initial-lang={lang}>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[40rem]" style="background: var(--hero-glow);"></div>
  <header class="sticky top-0 z-40 border-b border-[var(--border-soft)] bg-[color:color-mix(in_oklab,var(--bg)_82%,transparent)] backdrop-blur-xl">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
      <a href="#top" class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.18em] text-[var(--text-secondary)] uppercase">
        <span class="font-display text-[2rem] leading-none">
          <span class="text-[var(--text-primary)]">D</span><span class="text-[var(--accent-coral)]">R</span>
        </span>
        <span>Derwin Romero</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm text-[var(--text-secondary)] md:flex">
        {content.nav.map((item, index) => (
          <a href={item.href} class="transition hover:text-[var(--text-primary)]" data-nav-link data-nav-group="desktop" data-nav-index={index}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <button
          type="button"
          class="inline-flex h-11 items-center rounded-2xl border border-[var(--border-strong)] px-4 text-sm font-medium text-[var(--text-primary)] transition hover:border-[var(--accent-coral)] hover:text-[var(--accent-coral)]"
          data-locale-toggle
          aria-label="Toggle language"
        >
          <span data-locale-toggle-label>{lang === 'en' ? 'ES' : 'EN'}</span>
        </button>
        <ThemeToggle />
      </div>
    </div>

    <nav class="border-t border-[var(--border-soft)] px-4 py-3 md:hidden">
      <div class="mx-auto flex max-w-6xl gap-4 overflow-x-auto text-sm text-[var(--text-secondary)]">
        {content.nav.map((item, index) => (
          <a href={item.href} class="whitespace-nowrap transition hover:text-[var(--text-primary)]" data-nav-link data-nav-group="mobile" data-nav-index={index}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="relative mx-auto grid min-h-[calc(100svh-5.25rem)] max-w-6xl items-center gap-12 px-4 pb-18 pt-14 sm:px-6 lg:grid-cols-[1.02fr_0.98fr] lg:px-8 lg:pb-24 lg:pt-16">
      <div class="relative z-10">
        <h1 class="max-w-3xl font-display tracking-[-0.04em] text-[var(--text-primary)]">
          <span class="block text-5xl font-semibold sm:text-6xl lg:text-[4.35rem]" data-hero-name>{content.hero.name}</span>
          <span class="mt-2 block text-4xl font-semibold sm:text-5xl lg:text-[4rem]">
            <span class="text-[var(--accent-coral)]" data-hero-role-accent>{content.hero.roleAccent}</span>{' '}
            <span data-hero-role-title>{content.hero.roleTitle}</span>
          </span>
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-8 text-[var(--text-secondary)] sm:text-[1.35rem]" data-hero-intro>
          {content.hero.intro}
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={content.hero.resumeHref}
            download="Derwin-Romero-CV.pdf"
            data-hero-primary-cta
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--accent-coral)] px-6 py-3.5 text-sm font-semibold text-[var(--bg)] shadow-[0_18px_34px_rgba(255,107,129,0.22)] transition hover:translate-y-[-1px]"
          >
            <span data-hero-primary-cta-label>{content.hero.primaryCta}</span>
            <Icon name="external" class="size-4" />
          </a>
          <a
            href="#contact"
            data-hero-secondary-cta
            class="inline-flex items-center justify-center rounded-xl border border-[var(--border-strong)] bg-[var(--surface-subtle)] px-6 py-3.5 text-sm font-semibold text-[var(--text-primary)] transition hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)]"
          >
            <span data-hero-secondary-cta-label>{content.hero.secondaryCta}</span>
          </a>
        </div>

        <div class="mt-10">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--text-muted)]" data-hero-stack-label>{content.hero.stackLabel}</p>
          <div class="mt-5 flex flex-wrap items-center gap-5" data-hero-stack-list>
            {content.hero.stack.map((tech) => (
              <span class="text-sm font-semibold text-[var(--text-primary)]/95">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute right-8 top-6 hidden h-52 w-52 rounded-full bg-[var(--accent-cyan)]/18 blur-3xl lg:block"></div>
        <div class="absolute left-10 top-1/2 hidden h-40 w-40 -translate-y-1/2 rounded-full bg-[var(--accent-coral)]/18 blur-3xl lg:block"></div>
        <div class="relative">
          <img
            src="/images/hero-dev-illustration.png"
            alt="Abstract developer workstation hero visual with code panel and interface glow"
            class="relative z-10 ml-auto w-full max-w-[42rem] object-contain"
          />
        </div>
      </div>
    </section>

    <section id="about" class="mx-auto max-w-6xl border-t border-[var(--border-soft)] px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-coral)]" data-about-eyebrow>{content.about.eyebrow}</p>
      <div class="mt-4 grid gap-5 lg:grid-cols-[1.05fr_1.15fr]">
        <div>
          <h2 class="max-w-md font-display text-[2.1rem] font-semibold leading-tight text-[var(--text-primary)]" data-about-heading>
            {content.about.heading}
          </h2>
          <p class="mt-5 max-w-lg text-sm leading-7 text-[var(--text-secondary)]">
            <span data-about-summary>{content.about.summary}</span> <span class="text-[var(--text-primary)]" data-about-emphasis>{content.about.emphasis}</span>
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {content.about.highlights.map((highlight, index) => (
            <article class="group relative overflow-hidden rounded-[1.15rem] border border-[var(--border-strong)] bg-[var(--surface-card)] p-5 shadow-[var(--shadow-soft)] transition duration-300 hover:-translate-y-1 hover:border-[color:color-mix(in_oklab,var(--accent-cyan)_38%,var(--border-strong))] hover:shadow-[var(--shadow-strong)] md:min-h-[220px] md:p-6" data-highlight-card data-highlight-index={index}>
              <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,var(--accent-cyan),transparent)] opacity-60"></div>
              <div class="pointer-events-none absolute -right-12 top-0 h-28 w-28 rounded-full bg-[var(--accent-cyan)]/10 blur-3xl transition duration-300 group-hover:bg-[var(--accent-coral)]/12"></div>

              <div class="relative flex h-full flex-col">
                <div class="flex items-center gap-4">
                  <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-[var(--border-strong)] bg-[color:color-mix(in_oklab,var(--chip)_88%,transparent)] text-[var(--accent-cyan)] shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
                    <Icon name={highlight.icon} class="size-5" />
                  </span>
                  <div>
                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[var(--text-muted)]" data-about-strength-label>
                      {content.about.strengthLabel}
                    </p>
                    <h3 class="mt-1 font-display text-[1.35rem] leading-tight text-[var(--text-primary)]" data-highlight-name>{highlight.name}</h3>
                  </div>
                </div>

                <p class="mt-5 max-w-sm text-sm leading-7 text-[var(--text-secondary)]" data-highlight-description>
                  {highlight.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-8">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-[var(--text-muted)]" data-about-technologies-label>{content.about.technologiesLabel}</p>
        <div class="mt-4 flex flex-wrap gap-3" data-about-technologies-list>
          {content.about.technologies.map((tech) => (
            <span class="rounded-lg border border-[var(--border-strong)] bg-[var(--surface-subtle)] px-4 py-2 text-xs font-medium text-[var(--text-primary)]">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="relative border-t border-[var(--border-soft)] py-14">
      <div class="pointer-events-none absolute inset-0" style="background: var(--projects-glow);"></div>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-4">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-coral)]" data-projects-eyebrow>{content.projects.eyebrow}</p>
          <a href="#contact" class="text-sm font-medium text-[var(--accent-cyan)] transition hover:text-[var(--text-primary)]" data-projects-view-all>
            {content.projects.viewAllLabel}
          </a>
        </div>

        <div class="mt-6 grid gap-5 xl:grid-cols-2">
          {content.projects.items.map((project, index) => (
            <article class="grid overflow-hidden rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface-card)] shadow-[var(--shadow-soft)] md:grid-cols-[0.88fr_1.12fr]" data-project-card data-project-index={index}>
              <div class="aspect-[4/4] overflow-hidden bg-[var(--media-bg)] md:aspect-auto">
                <img
                  src={project.image}
                  alt={project.name}
                  loading="lazy"
                  data-project-image
                  class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]"
                />
              </div>
              <div class="p-5">
                <h3 class="font-display text-[1.7rem] text-[var(--text-primary)]" data-project-name>{project.name}</h3>
                <p class="mt-3 text-sm leading-6 text-[var(--text-secondary)]" data-project-summary>{project.summary ?? project.description}</p>
                <p class="mt-3 text-sm leading-6 text-[var(--text-secondary)]" data-project-description>{project.description}</p>
                <div class="mt-4 flex flex-wrap gap-2" data-project-techs>
                  {project.techs.map((tech) => (
                    <span class="rounded-lg border border-[var(--border-strong)] bg-[var(--chip)] px-2.5 py-1 text-[0.7rem] font-medium text-[var(--text-secondary)]">
                      {tech}
                    </span>
                  ))}
                </div>
                <a
                  href={project.href}
                  target="_blank"
                  rel="noreferrer"
                  data-project-cta
                  class="mt-5 inline-flex items-center gap-2 rounded-lg border border-[var(--border-strong)] px-3 py-2 text-sm font-semibold text-[var(--text-primary)] transition hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)]"
                >
                  <span data-project-cta-label>{project.cta}</span>
                  <Icon name="external" class="size-4" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="mx-auto max-w-6xl border-t border-[var(--border-soft)] px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-coral)]" data-experience-eyebrow>{content.experience.eyebrow}</p>
      <div class="mt-6 grid gap-8 xl:grid-cols-[0.42fr_1.58fr]">
        <div>
          <blockquote class="rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface-card-soft)] p-6 text-lg leading-8 text-[var(--text-primary)] shadow-[var(--shadow-soft)]">
            “<span data-experience-quote>{content.experience.quote}</span>”
            <footer class="mt-6 text-sm text-[var(--text-secondary)]">— <span data-experience-cite>{content.experience.cite}</span></footer>
          </blockquote>
        </div>

        <div class="relative pl-8">
          <div class="absolute left-2 top-0 bottom-0 w-px bg-[var(--border-strong)]"></div>

          <div class="relative">
            <div class="absolute -left-[1.9rem] top-1.5 h-3 w-3 rounded-full border border-[var(--accent-cyan)] bg-[var(--bg)]"></div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent-cyan)]" data-jobs-label>{content.experience.jobsLabel}</h3>
            <div class="mt-4 space-y-5">
              {content.experience.jobs.map((entry, index) => (
                <article class="flex flex-col gap-3 lg:flex-row lg:justify-between" data-job-entry data-job-index={index}>
                  <div>
                    <h4 class="font-display text-2xl text-[var(--text-primary)]" data-job-title>{entry.title}</h4>
                    {entry.organization && <p class="mt-1 text-sm text-[var(--text-secondary)]" data-job-organization>{entry.organization}</p>}
                    <p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--text-secondary)]" data-job-description>{entry.description}</p>
                  </div>
                  <time class="text-sm text-[var(--text-secondary)] lg:text-right" data-job-time>{entry.time}</time>
                </article>
              ))}
            </div>
          </div>

          <div class="relative mt-8">
            <div class="absolute -left-[1.9rem] top-1.5 h-3 w-3 rounded-full border border-[var(--accent-cyan)] bg-[var(--bg)]"></div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent-cyan)]" data-education-label>{content.experience.educationLabel}</h3>
            <div class="mt-4 space-y-5">
              {content.experience.education.map((entry, index) => (
                <article class="flex flex-col gap-3 lg:flex-row lg:justify-between" data-education-entry data-education-index={index}>
                  <div>
                    <h4 class="font-display text-2xl text-[var(--text-primary)]" data-education-title>{entry.title}</h4>
                    <p class="mt-1 text-sm text-[var(--text-secondary)]" data-education-organization>{entry.organization}</p>
                    <p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--text-secondary)]" data-education-description>{entry.description}</p>
                  </div>
                  <time class="text-sm text-[var(--text-secondary)] lg:text-right" data-education-time>{entry.time}</time>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="articles" class="relative border-t border-[var(--border-soft)] py-14">
      <div class="pointer-events-none absolute inset-0" style="background: var(--articles-glow);"></div>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-coral)]" data-articles-eyebrow>{content.articles.eyebrow}</p>

        <div class="mt-6 grid gap-6">
          {content.articles.items.map((article, index) => (
            <article class="grid overflow-hidden rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface-card)] shadow-[var(--shadow-soft)] md:grid-cols-[0.72fr_1.28fr]" data-article-card data-article-index={index}>
              <div class="aspect-[16/10] overflow-hidden bg-[var(--media-bg)] md:aspect-auto">
                <img
                  src={article.image}
                  alt={article.title}
                  loading="lazy"
                  data-article-image
                  class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]"
                />
              </div>
              <div class="p-6 md:p-7">
                <h3 class="max-w-2xl font-display text-[1.9rem] leading-tight text-[var(--text-primary)]" data-article-title>{article.title}</h3>
                <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--text-secondary)]" data-article-description>{article.description}</p>
                <div class="mt-5 flex flex-wrap items-center gap-4 text-xs text-[var(--text-muted)]">
                  <span data-article-date>{article.date}</span>
                  <span data-articles-read-time>{content.articles.readTimeLabel}</span>
                  <span class="text-[var(--accent-cyan)]" data-articles-topics>{content.articles.topicsLabel}</span>
                </div>
                <a
                  href={article.href}
                  target="_blank"
                  rel="noreferrer"
                  data-article-source-link
                  class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)] transition hover:text-[var(--accent-coral)]"
                >
                  <span data-articles-source>{content.articles.sourceLabel}</span>
                  <Icon name="external" class="size-4" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto min-h-[48rem] max-w-6xl border-t border-[var(--border-soft)] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-10 text-center">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-coral)]" data-contact-eyebrow>{content.contact.eyebrow}</p>
          <h2 class="mt-5 font-display text-[2.4rem] font-semibold tracking-[-0.03em] text-[var(--text-primary)] sm:text-[2.9rem]" data-contact-headline>
            {content.contact.headline}
          </h2>
          <p class="mt-6 text-base leading-8 text-[var(--text-secondary)]" data-contact-description>{content.contact.description}</p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-5" data-contact-social-row>
          {content.contact.socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="flex items-center gap-3 text-sm text-[var(--accent-cyan)] transition hover:text-[var(--text-primary)]"
            >
              <Icon name={link.icon} class="size-5" />
              <span>{link.label}</span>
            </a>
          ))}
        </div>

        <div class="w-full rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface-card-soft)] p-5 text-left shadow-[var(--shadow-soft)] md:p-7">
          <p class="font-display text-[1.7rem] text-[var(--accent-coral)]" data-contact-form-title>{content.contact.formTitle}</p>
          <form action={content.contact.formAction} method="POST" class="mt-5 grid gap-4 sm:grid-cols-2">
            <label class="grid gap-2 text-sm text-[var(--text-primary)]">
              <span data-contact-first-name-label>{content.contact.firstName}</span>
              <input name="firstName" required placeholder={content.contact.firstName} data-contact-first-name class="min-h-12 rounded-lg border border-[var(--border-strong)] bg-[var(--surface-input)] px-4 text-[var(--text-primary)] outline-none transition placeholder:text-[var(--text-muted)] focus:border-[var(--accent-coral)]" />
            </label>
            <label class="grid gap-2 text-sm text-[var(--text-primary)]">
              <span data-contact-last-name-label>{content.contact.lastName}</span>
              <input name="lastName" required placeholder={content.contact.lastName} data-contact-last-name class="min-h-12 rounded-lg border border-[var(--border-strong)] bg-[var(--surface-input)] px-4 text-[var(--text-primary)] outline-none transition placeholder:text-[var(--text-muted)] focus:border-[var(--accent-coral)]" />
            </label>
            <label class="grid gap-2 text-sm text-[var(--text-primary)] sm:col-span-2">
              <span data-contact-email-label>{content.contact.email}</span>
              <input type="email" name="email" required placeholder={content.contact.email} data-contact-email class="min-h-12 rounded-lg border border-[var(--border-strong)] bg-[var(--surface-input)] px-4 text-[var(--text-primary)] outline-none transition placeholder:text-[var(--text-muted)] focus:border-[var(--accent-coral)]" />
            </label>
            <label class="grid gap-2 text-sm text-[var(--text-primary)] sm:col-span-2">
              <span data-contact-message-label>{content.contact.message}</span>
              <textarea
                name="message"
                required
                rows="5"
                placeholder={content.contact.messagePlaceholder}
                data-contact-message
                class="rounded-lg border border-[var(--border-strong)] bg-[var(--surface-input)] px-4 py-3 text-[var(--text-primary)] outline-none transition placeholder:text-[var(--text-muted)] focus:border-[var(--accent-coral)]"
              ></textarea>
            </label>
            <button
              type="submit"
              data-contact-submit
              class="inline-flex min-h-12 items-center justify-center rounded-lg border border-[color:color-mix(in_oklab,var(--accent-coral)_78%,white)] bg-[color:color-mix(in_oklab,var(--accent-coral)_16%,transparent)] px-6 text-base font-semibold text-[var(--accent-coral)] transition hover:bg-[var(--accent-coral)] hover:text-[var(--bg)] sm:col-span-2"
            >
              {content.contact.submit}
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-[var(--border-soft)] bg-[rgba(8,16,32,0.56)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-[var(--text-secondary)] sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <p>© 2026 Derwin Romero</p>
      <p data-footer-built-with>{content.footer.builtWith}</p>
    </div>
  </footer>
</div>

<script is:inline define:vars={{ localeData: portfolioContent, initialLang: lang }}>
  const root = document.querySelector('[data-portfolio-root]');

  if (root) {
    const storageKey = 'portfolio-locale';
    const allContent = localeData;
    const currentPath = window.location.pathname;
    const detectPathLang = () => currentPath.startsWith('/es') ? 'es' : 'en';
    const header = root.querySelector('header');
    const navLinks = Array.from(root.querySelectorAll('[data-nav-link]'));
    const sectionIds = navLinks
      .map((link) => link.getAttribute('href'))
      .filter((href) => href?.startsWith('#'))
      .map((href) => href.slice(1));
    const sections = [...new Set(sectionIds)]
      .map((id) => document.getElementById(id))
      .filter(Boolean);
    let activeSectionId = '';
    let scrollTicking = false;

    const setText = (selector, value) => {
      const element = root.querySelector(selector);
      if (element) element.textContent = value;
    };

    const setPlaceholder = (selector, value) => {
      const element = root.querySelector(selector);
      if (element) element.setAttribute('placeholder', value);
    };

    const renderSimpleList = (selector, items, className) => {
      const container = root.querySelector(selector);
      if (!container) return;
      container.innerHTML = items.map((item) => `<span class="${className}">${item}</span>`).join('');
    };

    const setActiveNav = (sectionId) => {
      if (activeSectionId === sectionId) return;
      activeSectionId = sectionId;

      navLinks.forEach((link) => {
        const isActive = !!sectionId && link.getAttribute('href') === `#${sectionId}`;
        link.dataset.active = String(isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const syncActiveSection = () => {
      const headerOffset = header instanceof HTMLElement ? header.offsetHeight : 0;
      const activationLine = headerOffset + 28;

      const firstSection = sections[0];
      if (firstSection instanceof HTMLElement && firstSection.getBoundingClientRect().top > activationLine) {
        setActiveNav('');
        return;
      }

      let currentId = '';

      sections.forEach((section) => {
        if (section instanceof HTMLElement && section.getBoundingClientRect().top <= activationLine) {
          currentId = section.id;
        }
      });

      setActiveNav(currentId);
    };

    const queueActiveSectionSync = () => {
      if (scrollTicking) return;
      scrollTicking = true;
      window.requestAnimationFrame(() => {
        syncActiveSection();
        scrollTicking = false;
      });
    };

    const applyLocale = (locale) => {
      const content = allContent[locale];
      if (!content) return;

      document.documentElement.lang = locale;
      localStorage.setItem(storageKey, locale);
      root.dataset.locale = locale;

      const nextLabel = locale === 'en' ? 'ES' : 'EN';
      setText('[data-locale-toggle-label]', nextLabel);

      document.title = content.seo.title;
      const description = document.querySelector('meta[name="description"]');
      if (description) description.setAttribute('content', content.seo.description);

      const nextPath = locale === 'es' ? '/es/' : '/';
      if (window.location.pathname !== nextPath) {
        window.history.replaceState(window.history.state, '', nextPath + window.location.search + window.location.hash);
      }

      root.querySelectorAll('[data-nav-link]').forEach((link) => {
        const index = Number(link.getAttribute('data-nav-index'));
        if (content.nav[index]) link.textContent = content.nav[index].label;
      });

      setText('[data-hero-name]', content.hero.name);
      setText('[data-hero-role-accent]', content.hero.roleAccent);
      setText('[data-hero-role-title]', content.hero.roleTitle);
      setText('[data-hero-intro]', content.hero.intro);
      setText('[data-hero-primary-cta-label]', content.hero.primaryCta);
      setText('[data-hero-secondary-cta-label]', content.hero.secondaryCta);
      setText('[data-hero-stack-label]', content.hero.stackLabel);
      const resumeLink = root.querySelector('[data-hero-primary-cta]');
      if (resumeLink) resumeLink.setAttribute('href', content.hero.resumeHref);
      renderSimpleList('[data-hero-stack-list]', content.hero.stack, 'text-sm font-semibold text-[var(--text-primary)]/95');

      setText('[data-about-eyebrow]', content.about.eyebrow);
      setText('[data-about-heading]', content.about.heading);
      setText('[data-about-summary]', content.about.summary);
      setText('[data-about-emphasis]', content.about.emphasis);
      root.querySelectorAll('[data-about-strength-label]').forEach((element) => {
        element.textContent = content.about.strengthLabel;
      });
      root.querySelectorAll('[data-highlight-card]').forEach((card) => {
        const index = Number(card.getAttribute('data-highlight-index'));
        const highlight = content.about.highlights[index];
        if (!highlight) return;
        const name = card.querySelector('[data-highlight-name]');
        const descriptionText = card.querySelector('[data-highlight-description]');
        if (name) name.textContent = highlight.name;
        if (descriptionText) descriptionText.textContent = highlight.description;
      });
      setText('[data-about-technologies-label]', content.about.technologiesLabel);
      renderSimpleList('[data-about-technologies-list]', content.about.technologies, 'rounded-lg border border-[var(--border-strong)] bg-[var(--surface-subtle)] px-4 py-2 text-xs font-medium text-[var(--text-primary)]');

      setText('[data-projects-eyebrow]', content.projects.eyebrow);
      setText('[data-projects-view-all]', content.projects.viewAllLabel);
      root.querySelectorAll('[data-project-card]').forEach((card) => {
        const index = Number(card.getAttribute('data-project-index'));
        const project = content.projects.items[index];
        if (!project) return;
        const image = card.querySelector('[data-project-image]');
        const name = card.querySelector('[data-project-name]');
        const summary = card.querySelector('[data-project-summary]');
        const descriptionText = card.querySelector('[data-project-description]');
        const cta = card.querySelector('[data-project-cta]');
        const ctaLabel = card.querySelector('[data-project-cta-label]');
        const techs = card.querySelector('[data-project-techs]');
        if (image) {
          image.setAttribute('src', project.image);
          image.setAttribute('alt', project.name);
        }
        if (name) name.textContent = project.name;
        if (summary) summary.textContent = project.summary ?? project.description;
        if (descriptionText) descriptionText.textContent = project.description;
        if (cta) cta.setAttribute('href', project.href);
        if (ctaLabel) ctaLabel.textContent = project.cta;
        if (techs) {
          techs.innerHTML = project.techs
            .map((tech) => `<span class="rounded-lg border border-[var(--border-strong)] bg-[var(--chip)] px-2.5 py-1 text-[0.7rem] font-medium text-[var(--text-secondary)]">${tech}</span>`)
            .join('');
        }
      });

      setText('[data-experience-eyebrow]', content.experience.eyebrow);
      setText('[data-experience-quote]', content.experience.quote);
      setText('[data-experience-cite]', content.experience.cite);
      setText('[data-jobs-label]', content.experience.jobsLabel);
      setText('[data-education-label]', content.experience.educationLabel);

      root.querySelectorAll('[data-job-entry]').forEach((entry) => {
        const index = Number(entry.getAttribute('data-job-index'));
        const job = content.experience.jobs[index];
        if (!job) return;
        const title = entry.querySelector('[data-job-title]');
        const organization = entry.querySelector('[data-job-organization]');
        const descriptionText = entry.querySelector('[data-job-description]');
        const time = entry.querySelector('[data-job-time]');
        if (title) title.textContent = job.title;
        if (organization) organization.textContent = job.organization ?? '';
        if (descriptionText) descriptionText.textContent = job.description;
        if (time) time.textContent = job.time;
      });

      root.querySelectorAll('[data-education-entry]').forEach((entry) => {
        const index = Number(entry.getAttribute('data-education-index'));
        const education = content.experience.education[index];
        if (!education) return;
        const title = entry.querySelector('[data-education-title]');
        const organization = entry.querySelector('[data-education-organization]');
        const descriptionText = entry.querySelector('[data-education-description]');
        const time = entry.querySelector('[data-education-time]');
        if (title) title.textContent = education.title;
        if (organization) organization.textContent = education.organization ?? '';
        if (descriptionText) descriptionText.textContent = education.description;
        if (time) time.textContent = education.time;
      });

      setText('[data-articles-eyebrow]', content.articles.eyebrow);
      root.querySelectorAll('[data-article-card]').forEach((card) => {
        const index = Number(card.getAttribute('data-article-index'));
        const article = content.articles.items[index];
        if (!article) return;
        const image = card.querySelector('[data-article-image]');
        const title = card.querySelector('[data-article-title]');
        const descriptionText = card.querySelector('[data-article-description]');
        const date = card.querySelector('[data-article-date]');
        const readTime = card.querySelector('[data-articles-read-time]');
        const topics = card.querySelector('[data-articles-topics]');
        const source = card.querySelector('[data-articles-source]');
        const sourceLink = card.querySelector('[data-article-source-link]');
        if (image) {
          image.setAttribute('src', article.image);
          image.setAttribute('alt', article.title);
        }
        if (title) title.textContent = article.title;
        if (descriptionText) descriptionText.textContent = article.description;
        if (date) date.textContent = article.date;
        if (readTime) readTime.textContent = content.articles.readTimeLabel;
        if (topics) topics.textContent = content.articles.topicsLabel;
        if (source) source.textContent = content.articles.sourceLabel;
        if (sourceLink) sourceLink.setAttribute('href', article.href);
      });

      setText('[data-contact-eyebrow]', content.contact.eyebrow);
      setText('[data-contact-headline]', content.contact.headline);
      setText('[data-contact-description]', content.contact.description);
      setText('[data-contact-form-title]', content.contact.formTitle);
      setText('[data-contact-first-name-label]', content.contact.firstName);
      setText('[data-contact-last-name-label]', content.contact.lastName);
      setText('[data-contact-email-label]', content.contact.email);
      setText('[data-contact-message-label]', content.contact.message);
      setPlaceholder('[data-contact-first-name]', content.contact.firstName);
      setPlaceholder('[data-contact-last-name]', content.contact.lastName);
      setPlaceholder('[data-contact-email]', content.contact.email);
      setPlaceholder('[data-contact-message]', content.contact.messagePlaceholder);
      setText('[data-contact-submit]', content.contact.submit);

      setText('[data-footer-built-with]', content.footer.builtWith);
      queueActiveSectionSync();
    };

    const storedLocale = localStorage.getItem(storageKey);
    const startingLocale = storedLocale === 'en' || storedLocale === 'es' ? storedLocale : detectPathLang() || initialLang;
    applyLocale(startingLocale);

    const toggle = root.querySelector('[data-locale-toggle]');
    toggle?.addEventListener('click', () => {
      const currentLocale = document.documentElement.lang === 'es' ? 'es' : 'en';
      applyLocale(currentLocale === 'en' ? 'es' : 'en');
    });

    window.addEventListener('scroll', queueActiveSectionSync, { passive: true });
    window.addEventListener('resize', queueActiveSectionSync);
    window.addEventListener('hashchange', queueActiveSectionSync);
    queueActiveSectionSync();
  }
</script>
