---
import type { PortfolioContent } from 'data/portfolio';

interface Props {
  content: PortfolioContent['footer'];
}

const { content } = Astro.props;
---

<footer
  class="border-t border-[color:var(--border-soft)] bg-[color:rgba(8,16,32,0.56)]"
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-[color:var(--text-secondary)] sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8"
  >
    <p>© 2026 Derwin Romero</p>
    <p>{content.builtWith}</p>
  </div>
</footer>
