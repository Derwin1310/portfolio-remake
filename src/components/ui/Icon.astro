---
import BroadcastIcon from 'assets/icons/BroadcastIcon.astro';
import CheckIcon from 'assets/icons/CheckIcon.astro';
import DevicesIcon from 'assets/icons/DevicesIcon.astro';
import ExternalIcon from 'assets/icons/ExternalIcon.astro';
import GithubIcon from 'assets/icons/GithubIcon.astro';
import LinkedinIcon from 'assets/icons/LinkedinIcon.astro';
import LoaderIcon from 'assets/icons/LoaderIcon.astro';
import MoonIcon from 'assets/icons/MoonIcon.astro';
import ShieldIcon from 'assets/icons/ShieldIcon.astro';
import SparkIcon from 'assets/icons/SparkIcon.astro';
import SunIcon from 'assets/icons/SunIcon.astro';
import WorkflowIcon from 'assets/icons/WorkflowIcon.astro';
import XIcon from 'assets/icons/XIcon.astro';

type IconName =
  | 'external'
  | 'github'
  | 'linkedin'
  | 'x'
  | 'sun'
  | 'moon'
  | 'spark'
  | 'workflow'
  | 'shield'
  | 'broadcast'
  | 'devices'
  | 'loader'
  | 'check';

interface Props {
  name: IconName;
  class?: string;
  [key: string]: unknown;
}

const { name, class: className = 'size-5', ...attributes } = Astro.props;
const icons = {
  external: ExternalIcon,
  github: GithubIcon,
  linkedin: LinkedinIcon,
  x: XIcon,
  sun: SunIcon,
  moon: MoonIcon,
  spark: SparkIcon,
  workflow: WorkflowIcon,
  shield: ShieldIcon,
  broadcast: BroadcastIcon,
  devices: DevicesIcon,
  loader: LoaderIcon,
  check: CheckIcon,
} satisfies Record<IconName, typeof ExternalIcon>;
const IconComponent = icons[name];
---

<IconComponent class={className} {...attributes} />
