---
import Icon from './Icon.astro';
---

<button
  type="button"
  class="theme-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface-strong)] text-[var(--text-primary)] transition hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)]"
  aria-label="Toggle theme"
>
  <span class="theme-toggle__sun block dark-hidden">
    <Icon name="moon" class="size-5" />
  </span>
  <span class="theme-toggle__moon hidden light-hidden">
    <Icon name="sun" class="size-5" />
  </span>
</button>

<script is:inline>
  const root = document.documentElement;
  const storageKey = 'portfolio-theme';

  const applyTheme = (theme) => {
    root.dataset.theme = theme;
  };

  const initialTheme =
    localStorage.getItem(storageKey) || 'dark';

  applyTheme(initialTheme);

  const button = document.querySelector('.theme-toggle');

  button?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem(storageKey, nextTheme);
    applyTheme(nextTheme);
  });
</script>
