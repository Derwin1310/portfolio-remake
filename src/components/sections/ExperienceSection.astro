---
import type { TimelineEntry, PortfolioContent } from '../../data/portfolio';

interface Props {
  content: PortfolioContent['experience'];
}

interface TimelineProps {
  title: string;
  items: TimelineEntry[];
}

const { content } = Astro.props;

const timelineGroups: TimelineProps[] = [
  { title: content.jobsLabel, items: content.jobs },
  { title: content.educationLabel, items: content.education },
];
---

<section
  id="experience"
  class="mx-auto max-w-6xl border-t border-[var(--border-soft)] px-4 py-14 sm:px-6 lg:px-8"
>
  <p
    class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-coral)]"
  >
    {content.eyebrow}
  </p>
  <div class="mt-6 grid gap-8 xl:grid-cols-[0.42fr_1.58fr]">
    <div>
      <blockquote
        class="rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface-card-soft)] p-6 text-lg leading-8 text-[var(--text-primary)] shadow-[var(--shadow-soft)]"
      >
        "{content.quote}"
        <footer class="mt-6 text-sm text-[var(--text-secondary)]">
          - {content.cite}
        </footer>
      </blockquote>
    </div>

    <div class="relative pl-8">
      <div
        class="absolute left-2 top-0 bottom-0 w-px bg-[var(--border-strong)]"
      >
      </div>

      {
        timelineGroups.map((group, groupIndex) => (
          <div class:list={['relative', groupIndex > 0 && 'mt-8']}>
            <div class="absolute -left-[1.9rem] top-1.5 h-3 w-3 rounded-full border border-[var(--accent-cyan)] bg-[var(--bg)]" />
            <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent-cyan)]">
              {group.title}
            </h3>
            <div class="mt-4 space-y-5">
              {group.items.map((entry) => (
                <article class="flex flex-col gap-3 lg:flex-row lg:justify-between">
                  <div>
                    <h4 class="font-display text-2xl text-[var(--text-primary)]">
                      {entry.title}
                    </h4>
                    {entry.organization && (
                      <p class="mt-1 text-sm text-[var(--text-secondary)]">
                        {entry.organization}
                      </p>
                    )}
                    <p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--text-secondary)]">
                      {entry.description}
                    </p>
                  </div>
                  <time class="text-sm text-[var(--text-secondary)] lg:text-right">
                    {entry.time}
                  </time>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
