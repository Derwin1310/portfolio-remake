---
import type { PortfolioContent } from 'data/portfolio';
import Icon from 'components/ui/Icon.astro';

interface Props {
  content: PortfolioContent['contact'];
}

const { content } = Astro.props;
const inputClass =
  'min-h-12 rounded-lg border border-[color:var(--border-strong)] bg-[color:var(--surface-input)] px-4 text-[color:var(--text-primary)] outline-none transition placeholder:text-[color:var(--text-muted)] focus:border-[color:var(--accent-coral)]';
---

<section
  id="contact"
  class="mx-auto flex min-h-[calc(100svh-5.25rem)] max-w-6xl items-center border-t border-(--border-soft) px-4 py-16 sm:px-6 lg:px-8 lg:py-20"
>
  <div
    class="mx-auto flex w-full max-w-5xl flex-col items-center gap-10 text-center"
  >
    <div class="max-w-3xl" data-reveal="slide-up">
      <p
        class="text-xs font-semibold uppercase tracking-[0.22em] text-(--accent-coral)"
      >
        {content.eyebrow}
      </p>
      <h2
        class="mt-5 font-display text-[2.4rem] font-semibold tracking-normal text-(--text-primary) sm:text-[2.9rem]"
      >
        {content.headline}
      </h2>
      <p class="mt-6 text-base leading-8 text-(--text-secondary)">
        {content.description}
      </p>
    </div>

    <div
      class="flex flex-wrap items-center justify-center gap-5"
      data-reveal="slide-up"
    >
      {
        content.socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="magnetic-link flex items-center gap-3 text-sm text-(--accent-cyan) transition hover:text-(--text-primary)"
          >
            <Icon name={link.icon} class="size-5" />
            <span>{link.label}</span>
          </a>
        ))
      }
    </div>

    <div
      class="interactive-card w-full rounded-2xl border border-(--border-strong) bg-(--surface-card-soft) p-5 text-left [box-shadow:var(--shadow-soft)] md:p-7"
      data-reveal="slide-up"
    >
      <p
        class="font-display text-[1.7rem] text-(--accent-coral)"
      >
        {content.formTitle}
      </p>
      <form
        action={content.formAction}
        method="POST"
        class="mt-5 grid gap-4 sm:grid-cols-2"
      >
        <label class="grid gap-2 text-sm text-(--text-primary)">
          <span>{content.firstName}</span>
          <input
            name="firstName"
            required
            placeholder={content.firstName}
            class={inputClass}
          />
        </label>
        <label class="grid gap-2 text-sm text-(--text-primary)">
          <span>{content.lastName}</span>
          <input
            name="lastName"
            required
            placeholder={content.lastName}
            class={inputClass}
          />
        </label>
        <label
          class="grid gap-2 text-sm text-(--text-primary) sm:col-span-2"
        >
          <span>{content.email}</span>
          <input
            type="email"
            name="email"
            required
            placeholder={content.email}
            class={inputClass}
          />
        </label>
        <label
          class="grid gap-2 text-sm text-(--text-primary) sm:col-span-2"
        >
          <span>{content.message}</span>
          <textarea
            name="message"
            required
            rows="5"
            placeholder={content.messagePlaceholder}
            class="rounded-lg border border-(--border-strong) bg-(--surface-input) px-4 py-3 text-(--text-primary) outline-none transition placeholder:text-(--text-muted) focus:border-(--accent-coral)"
          ></textarea>
        </label>
        <button
          type="submit"
          class="magnetic-link inline-flex min-h-12 items-center justify-center rounded-lg border border-[color-mix(in_oklab,var(--accent-coral)_78%,white)] bg-[color-mix(in_oklab,var(--accent-coral)_16%,transparent)] px-6 text-base font-semibold text-(--accent-coral) transition hover:bg-(--accent-coral) hover:text-(--bg) sm:col-span-2"
        >
          {content.submit}
        </button>
      </form>
    </div>
  </div>
</section>
