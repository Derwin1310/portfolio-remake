---
import type { PortfolioContent } from 'data/portfolio';
import Icon from 'components/ui/Icon.astro';

interface Props {
  content: PortfolioContent['projects'];
}

const { content } = Astro.props;
---

<section id="projects" class="relative border-t border-(--border-soft) py-14">
  <div
    class="pointer-events-none absolute inset-0"
    style="background: var(--projects-glow);"
  >
  </div>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4" data-reveal="slide-up">
      <p
        class="text-xs font-semibold uppercase tracking-[0.22em] text-(--accent-coral)"
      >
        {content.eyebrow}
      </p>
      <a
        href="#contact"
        class="text-sm font-medium text-(--accent-cyan) transition hover:text-(--text-primary)"
      >
        {content.viewAllLabel}
      </a>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        content.items.map((project, index) => (
          <article
            class="interactive-card flex flex-col overflow-hidden rounded-lg border border-(--border-strong) bg-(--surface-card) [box-shadow:var(--shadow-soft)]"
            data-reveal="slide-up"
            style={`--reveal-delay: ${index * 110}ms`}
          >
            <div class="grid aspect-[8/5] place-items-center overflow-hidden bg-(--media-bg)">
              <img
                src={project.image.src}
                alt={project.imageAlt}
                width={project.image.width}
                height={project.image.height}
                loading="lazy"
                class:list={[
                  'media-zoom transition duration-500 hover:scale-[1.03]',
                  project.imageFit === 'contain'
                    ? 'h-auto max-h-full max-w-[70%] rounded-lg object-contain'
                    : 'h-full w-full object-cover',
                ]}
              />
            </div>
            <div class="p-5">
              <h3 class="font-display text-[1.7rem] text-(--text-primary)">
                {project.name}
              </h3>
              <p class="mt-3 text-sm leading-6 text-(--text-secondary)">
                {project.summary ?? project.description}
              </p>
              <p class="mt-3 text-sm leading-6 text-(--text-secondary)">
                {project.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.techs.map((tech) => (
                  <span class="rounded-lg border border-(--border-strong) bg-(--chip) px-2.5 py-1 text-[0.7rem] font-medium text-(--text-secondary)">
                    {tech}
                  </span>
                ))}
              </div>
              {project.link && (
                <a
                  href={project.link.href}
                  target="_blank"
                  rel="noreferrer"
                  class="magnetic-link mt-5 inline-flex items-center gap-2 rounded-lg border border-(--border-strong) px-3 py-2 text-sm font-semibold text-(--text-primary) transition hover:border-(--accent-cyan) hover:text-(--accent-cyan)"
                >
                  <span>{project.link.label}</span>
                  <Icon name="external" class="size-4" />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
